{
  "name": "hybrid-compute",
  "version": "0.0.0",
  "private": true,
  "description": "Composable compute orchestration across local, threaded, and remote environments.",
  "keywords": [
    "compute",
    "task-runner",
    "task-dispatcher",
    "job-queue",
    "web-worker",
    "threaded",
    "multithreaded",
    "remote",
    "fetch",
    "websocket",
    "rpc",
    "remote-procedure-call",
    "background-tasks",
    "modular",
    "pluggable",
    "framework",
    "orchestrator",
    "hybrid",
    "offloading",
    "compute-orchestration",
    "parallel-processing",
    "distributed-compute",
    "worker-pool",
    "edge-compute",
    "cloud-functions",
    "bff",
    "agent-tools",
    "ai-tools",
    "llm-agent",
    "compute-abstraction",
    "task-framework",
    "serverless",
    "nodejs",
    "typescript",
    "frontend-compute",
    "browser-compute",
    "isomorphic",
    "cross-environment"
  ],
  "homepage": "https://phun-ky.net/hybrid-compute/",
  "bugs": {
    "url": "https://github.com/phun-ky/hybrid-compute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/hybrid-compute.git"
  },
  "funding": "https://github.com/phun-ky/hybrid-compute?sponsor=1",
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "prebuild": "npm run clean",
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "commit": "npx git-cz",
    "docs:gen": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "predocs:dev": "npm run docs:gen",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:pack": "node scripts/check-pack.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check:sibling-ranges": "node scripts/check-sibling-ranges.mjs",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "bestpractices:url": "node scripts/bestpractices-url.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.3",
    "git-cz": "^4.9.0",
    "glob-bin": "^1.0.0",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "semver": "^7.8.5",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.2",
    "typedoc-plugin-frontmatter": "^1.0.0",
    "typedoc-plugin-markdown": "^4.2.3",
    "typedoc-plugin-mdn-links": "^5.0.1",
    "typedoc-plugin-no-inherit": "^1.4.0",
    "typedoc-plugin-remark": "^2.0.0",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typedoc-vitepress-theme": "^1.1.2",
    "unified-prettier": "^2.0.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.6.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  }
}
